{
  "name": "pdf-it-mcp",
  "version": "2.0.0",
  "mcpName": "io.github.mrslbt/pdf-it",
  "description": "MCP server and Claude Code skill that turns markdown into designed PDFs. Cover page, table of contents, code blocks that hold across page breaks, page-numbered footer. Native renderer, no Chrome dependency.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "anthropic",
    "anthropic-skill",
    "skill",
    "pdf",
    "pdf-generation",
    "pdf-generator",
    "markdown",
    "markdown-to-pdf",
    "report",
    "research",
    "react-pdf",
    "ai-agents",
    "cursor"
  ],
  "homepage": "https://github.com/mrslbt/pdf-it#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrslbt/pdf-it.git"
  },
  "bugs": {
    "url": "https://github.com/mrslbt/pdf-it/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Marsel Bait",
    "url": "https://marselbait.me"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pdf-it-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "samples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && npm run build:assets",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node test/integration.test.mjs",
    "prepublishOnly": "npm run build",
    "preview:cover": "tsx src/preview-cover.tsx",
    "preview:report": "tsx src/preview-research-report.tsx",
    "preview:chart": "tsx src/preview-chart.tsx",
    "build:assets": "node -e \"import('fs').then(({cpSync}) => cpSync('src/assets', 'dist/assets', {recursive: true}))\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-pdf/renderer": "^4.5.1",
    "react": "^19.2.0",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "mdast-util-to-string": "^4.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}